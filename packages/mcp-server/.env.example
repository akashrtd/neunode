# URL of the agnetd daemon (default: http://127.0.0.1:41000)
AGNETD_URL=http://127.0.0.1:41000

# Transport mode for the MCP server: "stdio" or "http"
# stdio = for local tools like Claude Code
# http  = for remote access via HTTP+SSE
MCP_TRANSPORT=stdio

# Port for HTTP transport mode (default: 3100)
MCP_PORT=3100
