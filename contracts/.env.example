# Neunode Contract Deployment Configuration
# Copy to .env and fill in values: cp .env.example .env

# Required: Private key for deployment (WITHOUT 0x prefix)
PRIVATE_KEY=

# RPC endpoints (optional — foundry.toml has defaults for Anvil/Holesky)
RPC_URL_HOLESKY=https://ethereum-holesky-rpc.publicnode.com
RPC_URL_MAINNET=

# Etherscan API key for contract verification (optional)
ETHERSCAN_API_KEY=
